# Copy to backend/.env and fill in values. Never commit .env

# --- Required for production ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sales_comp_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# --- CORS (comma-separated frontend URLs) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional ---
TIME_ZONE=Asia/Kolkata
# Only for dev/pilot onboarding — leave empty in production (users set passwords via admin)
# New User Setup rows with "Enable login" receive this password on first create.
DEFAULT_ONBOARDING_PASSWORD=Welcome@123

# --- Phase 3: pilot ops ---
# NOTIFY_EMAILS=ops@company.com,finance@company.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@yourcompany.com
# THROTTLE_LOGIN=10/min
# THROTTLE_UPLOAD=6/min
# THROTTLE_USER=120/min

# --- Phase 4: scale & enterprise ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# USE_ASYNC_IMPORTS=True
# ASYNC_IMPORT_MIN_ROWS=50
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# FRONTEND_URL=http://localhost:3000
# OIDC_ENABLED=False
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTHORIZATION_ENDPOINT=
# OIDC_OP_TOKEN_ENDPOINT=
# OIDC_OP_USER_ENDPOINT=
# OIDC_OP_JWKS_ENDPOINT=

# --- CRM integrations (optional) ---
# Configure connections in Admin → Integrations (Salesforce, REST API, webhooks).
# Webhook URLs appear after creating a Webhook integration.
# Salesforce: use Connected App OAuth or paste a valid access_token + instance_url.

# --- Commission AI assistant (natural-language Q&A in explanation panel) ---
# OPENAI_API_KEY=sk-...
# COMMISSION_AI_MODEL=gpt-4o-mini
# COMMISSION_AI_BASE_URL=https://api.openai.com/v1

# --- Production only (set DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# DJANGO_LOG_LEVEL=WARNING
# COMMISSIONS_LOG_LEVEL=INFO
