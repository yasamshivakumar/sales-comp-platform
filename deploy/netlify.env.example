# Netlify → Site settings → Environment variables → Production (and Deploy previews)
# Scope: builds only — baked into the React bundle at build time

REACT_APP_API_HOST=https://api.incentra.co.in
REACT_APP_API_BASE_URL=https://api.incentra.co.in/api
REACT_APP_USE_HTTPS=true
REACT_APP_DEBUG=false
REACT_APP_OIDC_ENABLED=false
REACT_APP_REQUEST_TIMEOUT_MS=60000

# After first deploy, add your Netlify URL to Render:
# CORS_ALLOWED_ORIGINS=https://incentra.co.in,https://www.incentra.co.in,https://YOUR-SITE.netlify.app
