# Render Web Service → Environment (backend root)
# Link Postgres: add DATABASE_URL from Render dashboard (Internal)

DEBUG=False
SECRET_KEY=generate-a-long-random-secret-here

DATABASE_URL=postgresql://user:pass@host:5432/sales_comp_db

ALLOWED_HOSTS=api.incentra.co.in,your-service-name.onrender.com
CORS_ALLOWED_ORIGINS=https://incentra.co.in,https://www.incentra.co.in
FRONTEND_URL=https://incentra.co.in

SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=True
TIME_ZONE=Asia/Kolkata

# No default onboarding password in production
DEFAULT_ONBOARDING_PASSWORD=

# Without Redis worker — sync imports only
CELERY_TASK_ALWAYS_EAGER=True

# Optional email
# NOTIFY_EMAILS=ops@incentra.co.in
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@incentra.co.in

# Optional Sentry
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
