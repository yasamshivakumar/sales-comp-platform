# ============================================================================
# REACT APPLICATION - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and .env.production and fill in your values

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API host (without /api suffix)
# Development: http://localhost:8000
# Production: https://your-domain.com
REACT_APP_API_HOST=http://localhost:8000

# Backend API base URL (with /api suffix)
# Development: http://localhost:8000/api
# Production: https://your-domain.com/api
REACT_APP_API_BASE_URL=http://localhost:8000/api

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Set to 'production' for production builds
NODE_ENV=development

# ============================================================================
# SECURITY
# ============================================================================
# Enable HTTPS in production (true/false)
REACT_APP_USE_HTTPS=false

# Enable debug logging in development (true/false)
REACT_APP_DEBUG=true

# ============================================================================
# FEATURES
# ============================================================================
# Enable analytics (true/false)
REACT_APP_ANALYTICS_ENABLED=false

# Maximum file upload size in MB
REACT_APP_MAX_UPLOAD_SIZE_MB=10

# Request timeout in milliseconds
REACT_APP_REQUEST_TIMEOUT_MS=30000

# Show SSO button (requires backend OIDC_ENABLED=True)
REACT_APP_OIDC_ENABLED=false

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit .env to git (only .env.example)
# 2. For production, set:
#    - REACT_APP_API_HOST to your production domain
#    - NODE_ENV=production
#    - REACT_APP_USE_HTTPS=true
#    - REACT_APP_DEBUG=false
# 3. Environment variables must start with REACT_APP_ to be accessible in React
#
# Production build example:
#   REACT_APP_API_HOST=https://api.yourcompany.com
#   REACT_APP_API_BASE_URL=https://api.yourcompany.com/api
#   REACT_APP_USE_HTTPS=true
#   REACT_APP_DEBUG=false
