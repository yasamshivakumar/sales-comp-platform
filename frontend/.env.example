# Copy to .env (local) and set the same variables in Vercel → Project → Settings → Environment Variables

# Render Django API (no trailing slash on host; base URL must end with /api)
REACT_APP_API_HOST=https://sales-comp-platform-1.onrender.com
REACT_APP_API_BASE_URL=https://sales-comp-platform-1.onrender.com/api

# Local development:
# REACT_APP_API_HOST=http://localhost:8000
# REACT_APP_API_BASE_URL=http://localhost:8000/api

REACT_APP_DEBUG=false
REACT_APP_REQUEST_TIMEOUT_MS=30000
REACT_APP_OIDC_ENABLED=false
