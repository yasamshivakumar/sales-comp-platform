# Local development — use /api + proxy in package.json
REACT_APP_API_BASE_URL=/api
REACT_APP_API_HOST=http://localhost:8000
REACT_APP_REQUEST_TIMEOUT_MS=30000
REACT_APP_OIDC_ENABLED=false
REACT_APP_DEBUG=false

# Optional: point at a remote API instead of localhost
# Vercel production example (set this in Vercel Project Settings)
# REACT_APP_API_BASE_URL=https://your-render-service.onrender.com/api
# REACT_APP_API_HOST=https://your-render-service.onrender.com
