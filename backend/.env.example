# Copy to backend/.env and fill in values. Never commit .env



# --- Required for production ---

SECRET_KEY=change-me-to-a-long-random-string

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1



# --- Database ---

# Optional: DATABASE_URL=postgres://user:pass@host:5432/dbname

DB_ENGINE=django.db.backends.postgresql

DB_NAME=sales_comp_db

DB_USER=postgres

DB_PASSWORD=1234

DB_HOST=localhost

DB_PORT=5432



# --- CORS (comma-separated frontend URLs) ---

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FRONTEND_URL=http://localhost:3000

# Render production example:
# DEBUG=False
# ALLOWED_HOSTS=your-render-service.onrender.com,.onrender.com
# FRONTEND_URL=https://your-vercel-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app



# --- Optional ---

TIME_ZONE=Asia/Kolkata

DEFAULT_ONBOARDING_PASSWORD=

# Idle session timeout in minutes (60 = 1 hour). Active API use extends the session.
TOKEN_TTL_MINUTES=60
# MFA_TOTP_ISSUER=Incentra

# Multi-tenant hard-off (production should leave unset / False).
# DEBUG and `manage.py test` default to True for legacy null-org rows.
# TENANT_ALLOW_DEFAULT_FALLBACK=False
# OIDC org binding: claim name and optional email-domain → org slug map
# OIDC_ORGANIZATION_CLAIM=organization_slug
# OIDC_EMAIL_DOMAIN_ORG_MAP=acme.com:acme,contoso.com:contoso



# --- CRM credential encryption (required when DEBUG=False) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# CREDENTIALS_ENCRYPTION_KEY=
# Optional previous keys (comma-separated) used only to decrypt during rotation:
# CREDENTIALS_ENCRYPTION_PREVIOUS_KEYS=
# Backend: encrypted_db (default) | aws_secrets_manager | azure_key_vault | hashicorp_vault
# SECRET_MANAGER_BACKEND=encrypted_db
# After deploy: python manage.py reencrypt_integration_credentials
# After key change: set PREVIOUS_KEYS to the old key, set KEY to the new key, then:
# python manage.py rotate_credentials_encryption_key



# --- Pilot ops ---

# NOTIFY_EMAILS=ops@company.com,finance@company.com

# Brevo SMTP example for production invite emails:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=20
# EMAIL_HOST_USER=your-brevo-smtp-login
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=verified-sender@yourcompany.com
# If DEFAULT_FROM_EMAIL is not set, the app falls back to EMAIL_HOST_USER.
# For Brevo/Gmail, use a verified sender address here to avoid invite failures.
# DEMO_REQUEST_EMAIL=shivakumar@incentra.co.in

# THROTTLE_LOGIN=10/min

# THROTTLE_UPLOAD=6/min

# THROTTLE_USER=120/min



# --- Error monitoring (optional, production recommended) ---

# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# SENTRY_ENVIRONMENT=production

# SENTRY_TRACES_SAMPLE_RATE=0.0

# SENTRY_SEND_DEFAULT_PII=False



# --- Async imports (optional) ---

# CELERY_BROKER_URL=redis://localhost:6379/0

# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# USE_ASYNC_IMPORTS=True

# ASYNC_IMPORT_MIN_ROWS=50



# --- SSO (optional) ---

# OIDC_ENABLED=False

# OIDC_RP_CLIENT_ID=

# OIDC_RP_CLIENT_SECRET=

# OIDC_OP_AUTHORIZATION_ENDPOINT=

# OIDC_OP_TOKEN_ENDPOINT=

# OIDC_OP_USER_ENDPOINT=

# OIDC_OP_JWKS_ENDPOINT=



# --- Commission AI assistant ---

# COMMISSION_AI_PROVIDER=ollama

# COMMISSION_AI_OLLAMA_MODEL=llama3.2:1b

# COMMISSION_AI_TIMEOUT=120

# OPENAI_API_KEY=sk-...

# COMMISSION_AI_MODEL=gpt-4o-mini

# AI_PLAN_BUILDER_ENABLED=True

# AI_DASHBOARD_INSIGHTS_ENABLED=True

# COMMISSION_AI_MAX_PROMPT_CHARS=24000

# COMMISSION_AI_MAX_RESPONSE_CHARS=48000



# --- Production only (set DEBUG=False) ---

# SECURE_SSL_REDIRECT=True

# SECURE_HSTS_SECONDS=31536000

# DJANGO_LOG_LEVEL=WARNING

# COMMISSIONS_LOG_LEVEL=INFO

